---
import { site } from '../data/site';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;

interface Props {
  /** Nav transparente con texto blanco, encima del hero. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header class:list={['container', { overlay }]}>
  <a href="/" class="logo" aria-label={`${site.name}, home`}>Leyla</a>
  <nav aria-label="Main">
    <ul>
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem;
  }
  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text);
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 0.9rem; /* ~14px: 2pt menos que el texto base (17px) */
    font-weight: 600;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.2s;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
  }
  .overlay .logo {
    color: #fff;
  }
  .overlay nav a {
    color: rgb(255 255 255 / 0.85);
  }
  .overlay nav a:hover {
    color: #fff;
  }
</style>

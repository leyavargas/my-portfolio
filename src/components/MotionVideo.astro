---
// Video que no se reproduce solo: arranca con un clic (o al pasar el mouse, sin sonido)
// y muestra la portada elegida mientras está detenido. Si el video tiene audio, aparece
// un botón para activar o desactivar el sonido (desactivado por defecto).
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: string;
  poster: ImageMetadata;
  label: string;
  // true solo si el video tiene sonido real.
  audio?: boolean;
  caption?: string;
  // Borde gris de 1px alrededor del video.
  bordered?: boolean;
  // Siempre en loop (como un GIF): se reproduce solo mientras está en pantalla, sin botones.
  ambient?: boolean;
}

const { src, poster, label, audio = false, caption, bordered = false, ambient = false } = Astro.props;
const posterImage = await getImage({ src: poster, width: Math.min(poster.width, 1920), format: 'webp', quality: 85 });
---

<figure class="motion-video">
<div class:list={['frame', { bordered, ambient }]} data-motion-video data-ambient={ambient ? '' : undefined} data-state="idle">
  <video
    src={src}
    poster={posterImage.src}
    width={poster.width}
    height={poster.height}
    muted
    loop
    playsinline
    preload="none"
    aria-label={label}
  ></video>
  {!ambient && <button class="play" type="button" aria-label={`Play: ${label}`}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path class="icon-play" d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
      <g class="icon-pause" fill="currentColor"><rect x="6.5" y="5.5" width="4" height="13" rx="1" /><rect x="13.5" y="5.5" width="4" height="13" rx="1" /></g>
    </svg>
  </button>}
  {
    audio && !ambient && (
      <button class="sound" type="button" aria-label="Turn sound on" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" stroke="none" />
          <g class="icon-muted"><path d="m16 9.5 5 5M21 9.5l-5 5" /></g>
          <g class="icon-on"><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" /></g>
        </svg>
      </button>
    )
  }
</div>
{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Modo "ambient": loop continuo mientras está en pantalla, sin hover ni botones.
  document.querySelectorAll<HTMLElement>('[data-motion-video][data-ambient]').forEach((box) => {
    const video = box.querySelector('video')!;
    if (reduceMotion) return;
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }, { threshold: 0.25 }).observe(box);
  });

  document.querySelectorAll<HTMLElement>('[data-motion-video]:not([data-ambient])').forEach((box) => {
    const video = box.querySelector('video')!;
    const playButton = box.querySelector<HTMLButtonElement>('.play')!;
    const soundButton = box.querySelector<HTMLButtonElement>('.sound');
    const label = video.getAttribute('aria-label') ?? '';
    // "playing": iniciado con clic (sigue aunque el mouse salga). "preview": solo hover.
    let state: 'idle' | 'preview' | 'playing' = 'idle';
    // Preferencia de sonido elegida con el botón (el hover siempre reproduce sin sonido).
    let soundOn = false;

    const setState = (next: typeof state) => {
      state = next;
      box.dataset.state = next;
      playButton.setAttribute('aria-label', `${next === 'playing' ? 'Pause' : 'Play'}: ${label}`);
    };

    // Vuelve a mostrar la portada (un video pausado mostraría el último fotograma).
    const reset = () => {
      video.pause();
      video.currentTime = 0;
      video.load();
    };

    const togglePlay = () => {
      if (state === 'playing') {
        video.pause();
        setState('idle');
      } else {
        video.muted = !soundOn;
        video.play().catch(() => {});
        setState('playing');
      }
    };

    playButton.addEventListener('click', togglePlay);
    video.addEventListener('click', togglePlay);

    if (canHover && !reduceMotion) {
      box.addEventListener('mouseenter', () => {
        if (state !== 'idle') return;
        video.muted = true;
        video.play().catch(() => {});
        setState('preview');
      });
      box.addEventListener('mouseleave', () => {
        if (state !== 'preview') return;
        reset();
        setState('idle');
      });
    }

    soundButton?.addEventListener('click', () => {
      soundOn = !soundOn;
      video.muted = !soundOn;
      soundButton.setAttribute('aria-pressed', String(soundOn));
      soundButton.setAttribute('aria-label', soundOn ? 'Turn sound off' : 'Turn sound on');
      box.dataset.sound = soundOn ? 'on' : 'off';
      // Activar el sonido también inicia el video.
      if (soundOn && state !== 'playing') {
        video.play().catch(() => {});
        setState('playing');
      }
    });

    // Si sale de la pantalla, se detiene.
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting && state !== 'idle') {
        video.pause();
        setState('idle');
      }
    }).observe(box);
  });
</script>

<style>
  .motion-video {
    margin-inline: 0;
  }
  .frame {
    position: relative;
    background: #000;
  }
  /* El borde va encima del video (no cambia su tamaño) y deja pasar los clics. */
  .bordered::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid #dcdcdc;
    pointer-events: none;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    cursor: pointer;
  }
  .ambient video {
    cursor: auto;
  }
  button {
    position: absolute;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    color: #fff;
    background: rgb(20 20 20 / 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    transition: opacity 0.25s ease, background-color 0.2s ease;
  }
  button:hover {
    background: rgb(20 20 20 / 0.75);
  }
  button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  /* Botón de reproducir: centrado mientras está detenido; en una esquina mientras se reproduce. */
  .play {
    left: 50%;
    top: 50%;
    width: 3.5rem;
    height: 3.5rem;
    transform: translate(-50%, -50%);
  }
  .icon-pause {
    display: none;
  }
  [data-state='preview'] .play {
    opacity: 0;
  }
  [data-state='playing'] .play {
    left: 0.75rem;
    top: auto;
    bottom: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    transform: none;
    opacity: 0;
  }
  [data-state='playing']:hover .play,
  [data-state='playing'] .play:focus-visible {
    opacity: 1;
  }
  [data-state='playing'] .icon-play {
    display: none;
  }
  [data-state='playing'] .icon-pause {
    display: inline;
  }
  /* Botón de sonido: siempre visible, abajo a la derecha. */
  .sound {
    right: 0.75rem;
    bottom: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
  }
  .icon-on {
    display: none;
  }
  [data-sound='on'] .icon-on {
    display: inline;
  }
  [data-sound='on'] .icon-muted {
    display: none;
  }
  /* En pantallas táctiles no hay hover: el botón de pausa queda visible mientras se reproduce. */
  @media (hover: none) {
    [data-state='playing'] .play {
      opacity: 1;
    }
  }
</style>

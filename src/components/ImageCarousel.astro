---
// Carrusel de imágenes para los casos de estudio: una imagen a la vez, a todo el ancho.
// Se desliza con trackpad/touch, arrastrando con el mouse o con las flechas.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  label?: string;
  /** Borde gris fino (0.5px, color de las líneas divisorias) alrededor de las imágenes. */
  bordered?: boolean;
}

const { images, label = 'Image carousel', bordered = false } = Astro.props;
---

<div class:list={['image-carousel', { bordered }]} data-image-carousel role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="viewport" data-viewport tabindex="0">
    {
      images.map(({ src, alt }, i) => (
        <figure class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${images.length}`}>
          <Image src={src} alt={alt} widths={[640, 960, 1280, 1680, 2080]} sizes="(min-width: 72rem) 67rem, 100vw" />
        </figure>
      ))
    }
  </div>

  <button class="arrow prev" type="button" data-prev aria-label="Previous image" disabled>
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M13 8H3M7 4 3 8l4 4" />
    </svg>
  </button>
  <button class="arrow next" type="button" data-next aria-label="Next image">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 8h10M9 4l4 4-4 4" />
    </svg>
  </button>

  <div class="dots" aria-hidden="true">
    {images.map((_, i) => <span class:list={['dot', { active: i === 0 }]} />)}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-image-carousel]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const dots = [...root.querySelectorAll<HTMLElement>('.dot')];
    const count = dots.length;

    const index = () => Math.round(viewport.scrollLeft / viewport.clientWidth);
    const go = (i: number) =>
      viewport.scrollTo({ left: Math.max(0, Math.min(count - 1, i)) * viewport.clientWidth, behavior: 'smooth' });

    const update = () => {
      const i = index();
      prev.disabled = i <= 0;
      next.disabled = i >= count - 1;
      dots.forEach((d, k) => d.classList.toggle('active', k === i));
    };

    prev.addEventListener('click', () => go(index() - 1));
    next.addEventListener('click', () => go(index() + 1));
    viewport.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
    });

    // Arrastrar con el mouse.
    let startX = 0, startScroll = 0, dragging = false;
    viewport.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      startX = e.clientX;
      startScroll = viewport.scrollLeft;
      viewport.setPointerCapture(e.pointerId);
      viewport.classList.add('is-dragging');
    });
    viewport.addEventListener('pointermove', (e) => {
      if (dragging) viewport.scrollLeft = startScroll - (e.clientX - startX);
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      viewport.classList.remove('is-dragging');
      const dx = e.clientX - startX;
      const i = Math.round(startScroll / viewport.clientWidth);
      go(Math.abs(dx) > viewport.clientWidth * 0.15 ? i + (dx < 0 ? 1 : -1) : i);
    };
    viewport.addEventListener('pointerup', end);
    viewport.addEventListener('pointercancel', end);
    viewport.addEventListener('dragstart', (e) => e.preventDefault());

    update();
  });
</script>

<style>
  .image-carousel {
    position: relative;
    margin-block: 2.5rem;
  }
  .viewport {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    cursor: grab;
  }
  .viewport::-webkit-scrollbar {
    display: none;
  }
  .viewport.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .viewport:focus-visible {
    outline-offset: 4px;
  }
  .bordered .viewport {
    border: 0.5px solid var(--line);
  }
  .slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
  }
  /* Selector más específico que el de las imágenes del caso (.prose img) para quitarles el margen. */
  .image-carousel .slide :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  /* Flechas: círculo blanco translúcido, sin borde. */
  .arrow {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
    background: rgb(255 255 255 / 0.85);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--text);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .prev {
    left: clamp(0.5rem, 2vw, 1.25rem);
  }
  .next {
    right: clamp(0.5rem, 2vw, 1.25rem);
  }
  .arrow:hover:not(:disabled) {
    transform: translateY(-50%) scale(1.06);
  }
  .arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }
  /* En celular, flecha 10% más chica (círculo e ícono). */
  @media (max-width: 40rem) {
    .arrow {
      width: 2.475rem;
      height: 2.475rem;
    }
    .arrow svg {
      width: 14.4px;
      height: 14.4px;
    }
  }

  /* Indicadores sobre la imagen, centrados abajo. */
  .dots {
    position: absolute;
    left: 50%;
    bottom: clamp(0.75rem, 2vw, 1.25rem);
    display: flex;
    gap: 0.4rem;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.2);
    transition:
      width 0.25s ease,
      background 0.25s ease;
  }
  .dot.active {
    width: 1.25rem;
    background: var(--text);
  }
</style>

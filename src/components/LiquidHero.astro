---
// Hero a sangre completa: video de fondo con efecto líquido (WebGL) que reacciona al cursor.
// Es sticky: al hacer scroll se queda fijo y la sección siguiente sube encima como una hoja.
---

<section class="liquid-hero">
  <video
    data-liquid-video
    src="/hero/cover.mp4"
    poster="/hero/cover-poster.jpg"
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  ></video>
  <canvas data-liquid aria-hidden="true"></canvas>
  <div class="content">
    <slot />
  </div>
</section>

<script>
  import { initLiquidVideo } from '../scripts/liquid-video';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.liquid-hero').forEach((hero) => {
    const canvas = hero.querySelector<HTMLCanvasElement>('canvas[data-liquid]');
    const video = hero.querySelector<HTMLVideoElement>('video[data-liquid-video]');
    if (!canvas || !video || reduceMotion) return; // Con "reducir movimiento" queda el póster fijo.
    try {
      // La hoja que sube es el siguiente elemento (Astro puede insertar un <script> entre medio).
      let sheet = hero.nextElementSibling;
      while (sheet?.tagName === 'SCRIPT') sheet = sheet.nextElementSibling;
      initLiquidVideo(canvas, video, sheet as HTMLElement | null);
    } catch (err) {
      console.warn('Liquid effect disabled:', err);
      video.play().catch(() => {});
    }
  });
</script>

<style>
  .liquid-hero {
    position: sticky;
    top: 0;
    z-index: 0;
    isolation: isolate;
    min-height: max(32rem, 100svh);
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #fff;
    background: #05050d;
    touch-action: pan-y;
  }
  video,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  canvas {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  canvas[data-ready] {
    opacity: 1;
  }
  .content {
    width: 100%;
    max-width: var(--max);
    padding-inline: var(--gutter);
    padding-block: 4rem;
    text-align: center;
    pointer-events: none;
  }
  .content :global(a) {
    pointer-events: auto;
  }
  /* Que el hero quede fijo durante toda la página (no solo dentro de <main>),
     para que la hoja siempre lo tape por completo, sin importar el alto de la pantalla. */
  :global(main:has(> .liquid-hero)) {
    display: contents;
  }
</style>

---
import { site } from '../data/site';
import { currentSite, currentSiteId } from '../data/sites';

// Tira con el nombre que se desliza al final del pie. El separador son los pétalos del favicon del sitio.
const markUrl = `url(/favicons/${currentSiteId}/mark.png)`; // solo los pétalos del favicon
const marqueeGroups = [0, 1]; // dos grupos iguales: la animación se mueve uno y vuelve a empezar sin salto
const namesPerGroup = [0, 1];

// Enlaces del pie: Home + redes. Los externos abren en otra pestaña.
const links = [
  { label: 'Home', href: '/', external: false },
  ...[...site.social, ...currentSite.footerLinks].map((s) => ({ ...s, external: true })),
];
---

<footer id="contact">
  <div class="container">
    <div class="top">
      <div class="cta">
        <h2>Let's work together</h2>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <ul>
        {
          links.map(({ label, href, external }) => (
            <li>
              <a href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <span class="arrow" aria-hidden="true">↗</span>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="marquee" aria-hidden="true" style={`--mark: ${markUrl}`}>
    <div class="track">
      {
        marqueeGroups.map(() => (
          <div class="group">
            {namesPerGroup.map(() => (
              <>
                <span class="name">{site.name}</span>
                <span class="mark" />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</footer>

<style>
  footer {
    --footer-pad: 7.05rem; /* footer 15% más alto que antes (378px → ~435px en escritorio) */
    position: relative;
    z-index: 1;
    padding-block: var(--footer-pad);
    background: #000;
    color: #fff;
  }
  /* Fila superior: título + correo a la izquierda, enlaces a la derecha a la altura del título. */
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }
  footer {
    --h2-size: clamp(2.1rem, 6.3vw, 3.675rem); /* 5% más grande que antes */
  }
  h2 {
    font-size: var(--h2-size);
    margin-top: 0;
  }
  .mail {
    font-size: 0.9625rem; /* 10% más grande que 14px */
    text-decoration: none;
  }
  .mail:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* Tira con el nombre (como la referencia, a la mitad de su altura), de borde a borde.
     Reemplaza el espacio inferior del pie: el bloque de arriba conserva el mismo aire debajo. */
  footer {
    padding-bottom: 0;
  }
  .marquee {
    margin-top: var(--footer-pad);
    overflow: hidden;
    color: #1c1c1c;
    font-size: clamp(3.5rem, 8.25vw, 10rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    user-select: none;
  }
  .track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .group {
    display: flex;
    align-items: center;
    padding-bottom: 0.24em; /* aire debajo del nombre, como en la referencia */
  }
  .name {
    padding-inline: 0.3em;
  }
  .mark {
    flex: none;
    width: 1em;
    height: 1em;
    margin-inline: 0.2em;
    background: currentColor;
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  /* Celular: menos negro antes de "Let's work together" y la tira separada del borde inferior
     (más el área segura del iPhone). */
  @media (max-width: 48rem) {
    footer {
      --footer-pad: 4.5rem;
      padding-bottom: calc(1.75rem + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
  /* Enlaces en columna, uno debajo del otro, en blanco.
     El margen alinea la parte de arriba de las mayúsculas de "Home" con la del título
     (métricas de Space Grotesk: el borde superior de las mayúsculas queda a 0.1985em
     del renglón del título con line-height 1.1, y a 0.453em del de los enlaces con 1.6). */
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    list-style: none;
    margin: calc(0.1985 * var(--h2-size) - 0.453em) 0 0;
    padding: 0;
  }
  ul a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  ul a:hover {
    opacity: 0.7;
  }
  .arrow {
    font-size: 0.85em;
    transition: transform 0.2s ease;
  }
  ul a:hover .arrow {
    transform: translate(2px, -2px);
  }
</style>

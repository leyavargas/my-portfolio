---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, excerpt, role, cover, coverVideo, accent, year } = project.data;
// Si el proyecto tiene video de hero, la tarjeta también se mueve (con la portada mientras carga).
const videoPoster = coverVideo && cover ? await getImage({ src: cover, width: 1200, format: 'webp', quality: 85 }) : undefined;
// Las etiquetas son las mismas del campo Role del overview.
const tags = role.split(',').map((tag) => tag.trim()).filter(Boolean);
---

<article class="card">
  <a href={`/work/${project.id}/`}>
    <div class="cover" style={`--card-accent: ${accent}`}>
      {
        coverVideo ? (
          <video data-card-video src={coverVideo} poster={videoPoster?.src} muted loop playsinline autoplay preload="auto" aria-hidden="true" />
        ) : cover ? (
          <Image src={cover} alt="" widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" />
        ) : (
          <span class="placeholder" aria-hidden="true">{title}</span>
        )
      }
    </div>
    <div class="meta">
      <h3>{title}</h3>
      <span class="year">{year}</span>
    </div>
    <p>{excerpt ?? summary}</p>
    <ul class="tags">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </a>
</article>

<script>
  // Los videos de las tarjetas se reproducen solos, en loop. Solo quedan quietos
  // si la persona prefiere menos movimiento.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-card-video]').forEach((video) => {
      video.removeAttribute('autoplay');
      video.pause();
    });
  }
</script>

<style>
  a {
    text-decoration: none;
    display: block;
  }
  .cover {
    aspect-ratio: 1.28;
    border-radius: 0;
    overflow: hidden;
    background: var(--card-accent);
    display: grid;
    place-items: center;
  }
  .cover img,
  .cover video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  a:hover .cover img,
  a:hover .cover video {
    transform: scale(1.03);
  }
  .placeholder {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    opacity: 0.6;
    padding: 1rem;
    text-align: center;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  h3 {
    font-size: 1.5rem;
    margin: 0;
  }
  .year {
    flex: none; /* el rango de años no se parte en dos líneas; el título se acomoda */
    color: var(--muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  p {
    color: var(--muted);
    margin: 0.5rem 0 1rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>

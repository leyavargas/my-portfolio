---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { currentSite } from '../data/sites';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  /** El nav se superpone al primer bloque de la página (p. ej. el hero). */
  overlayHeader?: boolean;
  /** Página sin nav (p. ej. los casos de estudio, que tienen su propio botón de volver). */
  hideHeader?: boolean;
  /** Color de fondo solo para esta página (sobrescribe --bg). */
  background?: string;
  /** Imagen para la vista previa al compartir (p. ej. la portada del proyecto). */
  shareImage?: ImageMetadata;
}

const {
  title,
  description = currentSite.description,
  overlayHeader = false,
  hideHeader = false,
  background,
  shareImage,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${currentSite.role}`;

// Links absolutos con la dirección del sitio que se está construyendo (UX o Brand).
const canonical = new URL(Astro.url.pathname, currentSite.url).href;
const ogImagePath = shareImage
  ? (await getImage({ src: shareImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : '/hero/cover-poster.jpg';
const ogImage = new URL(ogImagePath, currentSite.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style={background ? `--bg: ${background}` : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    {!hideHeader && <Header overlay={overlayHeader} />}
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    padding-bottom: 6rem;
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 100;
    background: var(--text);
    color: var(--bg);
    padding: 0.5em 1em;
    border-radius: 0.5em;
  }
</style>

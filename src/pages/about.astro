---
import BaseLayout from '../layouts/BaseLayout.astro';
import { currentSite } from '../data/sites';

const { about } = currentSite;

// Texto provisional (sitio Brand): marca visible para no publicarlo por error.
// Va en línea (no en <style>) para que el sitio UX quede idéntico.
const pendingStyle = 'padding: 1rem 1.25rem; border: 2px dashed #e0a100; background: #fff8e1;';
---

<BaseLayout title="About" background="#fff">
  <section class="container about">
    <h1>{about.title}</h1>
    <div
      class="text"
      style={about.pending ? pendingStyle : undefined}
      data-pending={about.pending ? 'true' : undefined}
    >
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2.5rem clamp(3rem, 11vw, 10rem);
    align-items: start;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  h1 {
    font-size: clamp(2.75rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1;
    margin: 0;
    white-space: nowrap;
  }
  .text {
    font-size: clamp(1.0625rem, 1.3vw, 1.125rem);
    font-weight: 300; /* Space Grotesk Light */
    line-height: 1.75;
  }
  .text p {
    margin: 0;
  }
  .text p + p {
    margin-top: 1.5em;
  }

  @media (max-width: 48rem) {
    .about {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    h1 {
      white-space: normal;
    }
  }
</style>

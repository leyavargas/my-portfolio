---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">{site.role}</p>
    <h1>
      Diseño experiencias digitales <em>claras, útiles</em> y centradas en las personas.
    </h1>
    <p class="lead">
      Combino investigación, arquitectura de información y diseño visual para convertir problemas
      complejos en productos simples de usar.
    </p>
    <a class="button" href="#proyectos">Ver proyectos ↓</a>
  </section>

  <section id="proyectos" class="container">
    <h2>Proyectos seleccionados</h2>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 9rem);
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    max-width: 18ch;
    margin-top: 0.75rem;
  }
  h1 em {
    color: var(--accent);
  }
  .lead {
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 40ch;
    margin-bottom: 2rem;
  }
  #proyectos h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
    gap: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }
</style>

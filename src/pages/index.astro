---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LiquidHero from '../components/LiquidHero.astro';
import GlowButton from '../components/GlowButton.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
---

<BaseLayout overlayHeader background="#fff">
  <LiquidHero>
    <!-- La tira mide lo mismo que la primera línea del titular (lo calcula el script de abajo). -->
    <div class="hero-copy">
      <ul class="disciplines" aria-label="Disciplines">
        <li>Product Design</li>
        <li>UX/UI</li>
        <li>Visual Systems</li>
      </ul>
      <h1>Product designer with a <br class="br-wide" />background in brand identity</h1>
    </div>
    <div class="hero-cta">
      <GlowButton href="#work" label="See My Work" />
    </div>
  </LiquidHero>

  <section id="work">
    <div class="container">
      <h2>Work</h2>
      <div class="grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Ajusta la tira de disciplinas al ancho real de la primera línea del titular.
  const title = document.querySelector<HTMLElement>('.liquid-hero h1');
  const strip = document.querySelector<HTMLElement>('.disciplines');
  if (title && strip) {
    const fit = () => {
      const range = document.createRange();
      range.selectNodeContents(title);
      const rects = [...range.getClientRects()].filter((r) => r.width > 0);
      if (!rects.length) return;
      const firstTop = Math.min(...rects.map((r) => r.top));
      const line = rects.filter((r) => Math.abs(r.top - firstTop) < 2);
      const width = Math.max(...line.map((r) => r.right)) - Math.min(...line.map((r) => r.left));
      strip.style.setProperty('--strip-width', `${Math.round(width)}px`);
    };
    document.fonts.ready.then(fit);
    new ResizeObserver(fit).observe(title);
  }

  // Ease suave para la hoja blanca (#work) que sube sobre el hero.
  // El scroll nativo es lineal; aquí la hoja sigue una curva ease-in-out mezclada a medias
  // con el movimiento lineal (EASE_AMOUNT), y el desplazamiento se interpola cuadro a cuadro
  // para que se sienta continuo. Al empezar y al terminar de cubrir el hero, coincide exacto.
  const sheet = document.querySelector<HTMLElement>('#work');
  const hero = document.querySelector<HTMLElement>('.liquid-hero');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (sheet && hero && !reduceMotion) {
    const EASE_AMOUNT = 0.5; // 0 = lineal, 1 = ease-in-out completo
    const SMOOTHING = 0.18; // cuánto se acerca al objetivo en cada cuadro
    const easeInOut = (t: number) => 0.5 - Math.cos(Math.PI * t) / 2;
    let current = 0;
    let raf = 0;

    const target = () => {
      const h = hero.offsetHeight;
      const p = Math.min(1, Math.max(0, window.scrollY / h));
      const eased = p + (easeInOut(p) - p) * EASE_AMOUNT;
      return (p - eased) * h; // px: positivo = la hoja va un poco más abajo
    };

    const tick = () => {
      const t = target();
      current += (t - current) * SMOOTHING;
      if (Math.abs(t - current) < 0.1) current = t;
      sheet.style.transform = Math.abs(current) < 0.1 ? '' : `translate3d(0, ${current.toFixed(2)}px, 0)`;
      raf = current === t ? 0 : requestAnimationFrame(tick);
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();
  }
</script>

<style>
  /* Mismo espacio entre la tira, el titular y el botón. */
  :global(.liquid-hero) {
    /* ~165px en una pantalla de escritorio (≈17% del alto), según la referencia.
       Se achica en pantallas angostas para que todo quepa. */
    --hero-gap: max(3rem, min(17svh, 23vw, 11rem));
  }
  /* Tira de disciplinas: una a la izquierda, una al centro y una a la derecha. */
  .hero-copy {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  .disciplines {
    width: var(--strip-width, 100%);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    margin: 0 auto var(--hero-gap);
    padding: 0;
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    font-weight: 400;
    color: rgb(255 255 255 / 0.7);
  }
  h1 {
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    font-weight: 400;
    margin: 0;
    text-shadow: 0 2px 30px rgb(0 0 20 / 0.35);
  }
  /* La hoja blanca que sube y tapa el hero (borde recto). */
  /* El salto de línea fijo solo en pantallas anchas; en celular el titular se ajusta solo. */
  .br-wide {
    display: none;
  }
  @media (min-width: 48rem) {
    .br-wide {
      display: inline;
    }
  }
  .hero-cta {
    margin-top: var(--hero-gap);
    display: flex;
    justify-content: center;
  }
  #work {
    position: relative;
    z-index: 1;
    background: var(--bg);
    padding-block: clamp(6rem, 14vw, 11rem);
  }
  #work h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 2vw, 1.75rem);
  }
  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/projects';
import NextProjects from '../../components/NextProjects.astro';
import GlowButton from '../../components/GlowButton.astro';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    // Los demás proyectos, empezando por el siguiente y dando la vuelta.
    props: { project, others: [...projects.slice(i + 1), ...projects.slice(0, i)] },
  }));
}

const { project, others } = Astro.props;
const { title, summary, client, role, team, year, cover, coverMobile, coverVideo, coverVideoMobile, accent, impact } = project.data;

// En pantallas verticales (celular) se usa la versión vertical del hero, si el proyecto la tiene.
const HERO_MOBILE_MEDIA = '(max-aspect-ratio: 3/4)';
const heroMobile = coverMobile
  ? await getImage({ src: coverMobile, widths: [750, 1125, 1500], quality: 92 })
  : undefined;

// Portada del video del hero (se ve mientras carga, o fija si la persona prefiere menos movimiento).
const heroVideoPoster = coverVideo && cover ? await getImage({ src: cover, width: 1920, format: 'webp', quality: 85 }) : undefined;

const { Content, headings } = await render(project);

// Menú lateral con los títulos principales (h2), en todos los proyectos que tengan
// más de una sección.
const sections = headings.filter((h) => h.depth === 2);
const showNav = sections.length >= 2;

// El resumen puede tener varios párrafos, separados por una línea en blanco.
const summaryParagraphs = summary.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const description = summaryParagraphs.join(' ');

const facts = [
  // "Clients" en plural cuando hay más de uno (p. ej. "eBay, Dentons & DiDi").
  { label: client && /,|&/.test(client) ? 'Clients' : 'Client', value: client },
  { label: 'Role', value: role },
  { label: 'Team', value: team },
  { label: 'Year', value: year },
].filter((f) => f.value);
---

<BaseLayout title={title} description={description} shareImage={cover} hideHeader background="#fff">
  <article>
    <div class="hero" style={`background: ${accent}`}>
      {
        coverVideo ? (
          <video
            class="hero-video"
            data-hero-video
            data-src={coverVideo}
            data-src-mobile={coverVideoMobile}
            data-poster={heroVideoPoster?.src}
            data-poster-mobile={coverVideoMobile ? heroMobile?.src : undefined}
            poster={heroVideoPoster?.src}
            muted
            loop
            playsinline
            preload="auto"
            aria-hidden="true"
          />
        ) : cover && (
          <picture>
            {heroMobile && <source media={HERO_MOBILE_MEDIA} srcset={heroMobile.srcSet.attribute} sizes="100vw" />}
            <Image
              src={cover}
              alt=""
              widths={[1280, 1920, 2560, 3840]}
              sizes="100vw"
              quality={92}
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        )
      }
      <div class="scroll-hint">
        <GlowButton href="/" label="Home" arrowBack />
        <GlowButton href="#overview" label="Scroll" arrowDown />
      </div>
    </div>

    <!-- Todo lo que sigue sube encima del hero (que queda fijo), como "Work" en el inicio. -->
    <div class="sheet">
      <header class="overview" id="overview">
        <div class="container">
          <h1>{title}</h1>
          <div class="intro">
            <dl class="facts">
              {
                facts.map(({ label, value }) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="summary">
              {summaryParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>
          {
            impact.length > 0 && (
              <section class="impact" aria-labelledby="impact-title">
                <h2 id="impact-title">Impact</h2>
                <ul>
                  {impact.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>
      </header>

      <div class="body">
        <div class:list={['case-layout', { 'has-nav': showNav }]}>
          {
            showNav && (
              <div class="case-nav-track">
                <nav class="case-nav" aria-label="Sections" data-case-nav>
                  <ul>
                    {sections.map(({ slug, text }) => (
                      <li>
                        <a href={`#${slug}`}>
                          {/* Las palabras con guion (p. ej. "Trade-Offs") no se cortan en dos líneas. */}
                          {text.split(/(\S+-\S+)/).map((part) => (/\S-\S/.test(part) ? <span class="nowrap">{part}</span> : part))}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            )
          }
          <div class="container prose">
            <Content />
          </div>
        </div>

        {others.length > 0 && <NextProjects projects={others} />}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Hero a pantalla completa. Queda fijo al hacer scroll y el overview sube encima. */
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    min-height: 28rem;
    overflow: hidden;
  }
  .hero picture {
    display: contents;
  }
  .hero img,
  .hero video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Botones "Home" y "Scroll" (mismo estilo que "See My Work"), juntos y centrados abajo del hero. */
  .scroll-hint {
    position: absolute;
    display: flex;
    gap: 1.25rem;
    left: 50%;
    bottom: clamp(1rem, 2vw, 1.75rem);
    transform: translateX(-50%);
  }
  /* Los heros de los proyectos son claros: vidrio con un tinte oscuro para que el texto blanco se lea. */
  .scroll-hint :global(.glow-button) {
    background: rgb(8 14 30 / 0.32);
    /* 20% más chico que "See My Work" (texto, padding e ícono). */
    font-size: calc(clamp(1rem, 1.4vw, 1.15rem) * 0.8);
    padding: 0.8rem 1.92rem;
  }
  .scroll-hint :global(.glow-button svg) {
    width: 11.2px;
    height: 11.2px;
  }
  /* La hoja que tapa el hero: overview negro + contenido. */
  .sheet {
    position: relative;
    z-index: 1;
  }
  /* Mismo espacio antes de "Next project" (fin del contenido → línea) y después
     (imágenes → footer): --section-end. */
  .body {
    --section-end: calc(clamp(4rem, 8vw, 6rem) + 1.5rem); /* el espacio verde original: ~120px escritorio */
    background: var(--bg);
    padding-bottom: calc(var(--section-end) * 1.32); /* debajo de "Next project": +20% y luego +10% */
  }
  :global(main:has(.sheet)) {
    padding-bottom: 0; /* el espacio antes del footer lo da .body */
  }

  .overview {
    --pad: clamp(4rem, 9vw, 8rem);
    --title-size: clamp(2.5rem, 7vw, 4.5rem);
    background: #000;
    color: #fff;
    padding-block: var(--pad);
  }
  h1 {
    font-size: var(--title-size);
    font-weight: 400;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
  }
  /* Columnas compartidas por la intro y por Impact, para que queden alineadas. */
  .overview {
    --cols: minmax(0, 5fr) minmax(0, 7fr);
    --col-gap: clamp(2rem, 6vw, 6rem);
  }
  .intro {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 2.5rem var(--col-gap);
    align-items: start;
  }
  .facts {
    margin: 0;
    max-width: 22rem;
  }
  .facts div + div {
    margin-top: 1.5rem; /* 24px entre categorías */
  }
  dt {
    color: rgb(255 255 255 / 0.55);
    font-weight: 300;
  }
  dd {
    margin: 0.25rem 0 0;
    font-weight: 400;
  }
  .summary {
    font-size: 1.3rem;
    font-weight: 300;
    line-height: 1.55;
  }
  .summary p {
    margin: 0;
  }
  .summary p + p {
    margin-top: 1em;
  }

  .impact {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 2.5rem);
    border-top: 0.5pt solid rgb(255 255 255 / 0.45);
  }
  .impact h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 500;
    margin: 0 0 1.75rem;
  }
  .impact ul {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 1.25rem var(--col-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    font-weight: 400; /* mismo peso y tamaño que los valores de Role / Year */
  }

  @media (max-width: 48rem) {
    .intro,
    .impact ul {
      grid-template-columns: 1fr;
    }
  }

  /* Menú lateral de secciones: pegado al borde izquierdo de la pantalla, fuera del contenido,
     que conserva sus márgenes. Solo aparece cuando el margen izquierdo tiene espacio para él. */
  .case-layout {
    position: relative;
  }
  .case-nav-track {
    display: none;
  }
  @media (min-width: 90rem) {
    .case-nav-track {
      display: block;
      position: absolute;
      left: 1.25rem;
      width: 9.5rem;
      /* Recorre todo el contenido: empieza con el primer titular y termina con el último bloque. */
      top: clamp(4rem, 8vw, 6rem);
      bottom: var(--section-end);
    }
  }
  .case-nav {
    position: sticky;
    top: 2.5rem;
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
  }
  .case-nav ul {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .case-nav a {
    display: block;
    padding: 0.9rem 0 0.9rem 0.75rem; /* doble de espacio entre secciones */
    font-size: 0.75rem; /* 12px */
    line-height: 1.35;
    font-weight: 300; /* mismo peso que el texto del caso (Space Grotesk Light) */
    color: #767676; /* titulares inactivos: el gris más claro con contraste 4.5:1 sobre blanco (WCAG AA) */
    text-decoration: none;
    transition: color 0.45s var(--easy-ease), font-weight 0.45s var(--easy-ease);
  }
  .case-nav .nowrap {
    white-space: nowrap;
  }
  .case-nav a:hover {
    color: var(--muted);
  }
  .case-nav a[aria-current='true'] {
    color: var(--text);
    font-weight: 600;
  }
  /* Barra de la sección activa: se desliza entre titulares con "easy ease". */
  .case-nav ul::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: var(--bar-h, 0);
    border-radius: 2px;
    background: var(--text);
    transform: translateY(var(--bar-y, 0));
    opacity: var(--bar-o, 0);
    transition: transform 0.6s var(--easy-ease), height 0.6s var(--easy-ease), opacity 0.3s var(--easy-ease);
  }
  .case-layout {
    /* "Easy ease" de After Effects. */
    --easy-ease: cubic-bezier(0.33, 0, 0.67, 1);
  }

  /* Contenido del caso de estudio (Markdown/MDX). */
  /* Mismo ancho y márgenes que el overview (.container). */
  .prose {
    padding-block: clamp(4rem, 8vw, 6rem) var(--section-end);
    font-size: 1.125rem;
    font-weight: 300; /* Space Grotesk Light para el texto; los títulos y negritas mantienen su peso */
    line-height: 1.7;
  }
  /* En celular: texto del cuerpo de 16px con interlineado de 24px. */
  @media (max-width: 48rem) {
    .prose {
      font-size: 1rem;
      line-height: 1.5;
    }
  }
  .prose :global(p) {
    margin: 0 0 1.4em;
  }
  .prose :global(h2) {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    margin: var(--block-gap) 0 0.7em;
  }
  .prose > :global(:last-child) {
    margin-bottom: 0;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  /* Subtítulos de los casos de estudio (mismo estilo en todos los proyectos). */
  .prose :global(h3) {
    font-size: 1.375rem; /* 22px en escritorio; 18px en celular (abajo) */
    font-weight: 500;
    margin: 2em 0 0.8em;
  }
  /* En celular: titulares (h2) de 26px y subtítulos (h3) de 18px
     (va después de las reglas generales para reemplazarlas). */
  @media (max-width: 48rem) {
    .prose :global(h2) {
      font-size: 1.625rem;
    }
    .prose :global(h3) {
      font-size: 1.125rem;
    }
  }
  .prose :global(ol),
  .prose :global(ul) {
    padding-left: 1.5em;
    margin: 0 0 1.4em;
  }
  .prose :global(li + li) {
    margin-top: 0.4em;
  }
  /* Números de las listas numeradas en negrita, igual que el texto en negrita que los sigue. */
  .prose :global(ol > li::marker) {
    font-weight: 600;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0;
    margin-block: 2.5rem;
  }
  /* Imágenes, filas, carruseles y videos seguidos se separan con el mismo espacio
     que hay entre las columnas de una fila (--media-gap), en escritorio y en celular. */
  .prose {
    --media-gap: clamp(0.75rem, 2vw, 1.25rem);
    /* Espacio entre bloques de texto y medios (imagen → titular y texto → imagen):
       el mismo arriba y abajo de cada bloque de texto, para que quede centrado. */
    --block-gap: clamp(3rem, 5.5vw, 4.4rem);
  }
  .prose > :global(:is(img, video, .image-row, .image-carousel, .motion-video)) {
    margin-block: var(--block-gap);
  }
  /* (Astro inserta un <script> después de algunos componentes, como el carrusel: se ignora.) */
  .prose > :global(:is(img, video, .image-row, .image-carousel, .motion-video):has(+ :is(img, video, .image-row, .image-carousel, .motion-video), + script + :is(img, video, .image-row, .image-carousel, .motion-video))) {
    margin-bottom: 0;
  }
  .prose > :global(:is(img, video, .image-row, .image-carousel, .motion-video) + :is(img, video, .image-row, .image-carousel, .motion-video)),
  .prose > :global(:is(img, video, .image-row, .image-carousel, .motion-video) + script + :is(img, video, .image-row, .image-carousel, .motion-video)) {
    margin-top: var(--media-gap);
  }
  /* En celular, el titular (h2) tiene ~50px arriba (venga después de un párrafo, una lista
     o una imagen) y 24px abajo, para que se lea junto con su texto. */
  @media (max-width: 48rem) {
    .prose :global(h2) {
      margin-bottom: 1.5rem; /* 24px: el titular queda más cerca de su texto que del bloque anterior */
    }
    .prose > :global(:is(img, video, .image-row, .image-carousel, .motion-video) + h2),
    .prose > :global(:is(img, video, .image-row, .image-carousel, .motion-video) + script + h2),
    .prose > :global(:is(ul, ol) + h2) {
      margin-top: calc(var(--block-gap) + 5px);
    }
  }
  /* Fila de tres imágenes (p. ej. bici · grupo · moto). */
  .prose :global(.image-row) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--media-gap);
  }
  /* Variante de dos columnas (citas, prototipos), con leyenda opcional debajo. */
  .prose :global(.image-row--2) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .prose :global(.image-row figure) {
    margin: 0;
  }
  /* Formato de pies de imagen (captions) para todos los casos de estudio:
     más chico que el texto, en gris y en Regular (no Light) para que se lea bien.
     #6b6b6b sobre blanco = contraste 5.3:1 (cumple WCAG AA). */
  .prose :global(figcaption),
  .prose :global(.note) {
    margin-top: 0.75rem;
    font-size: 0.9375rem; /* 15px */
    font-weight: 400;
    line-height: 1.5;
    color: var(--muted);
  }
  .prose :global(.image-row img) {
    margin: 0;
  }
  /* Fila de tres: misma altura para las tres imágenes, como en la referencia de DiDi. */
  .prose :global(.image-row:not(.image-row--2) img) {
    aspect-ratio: 324 / 417;
    object-fit: cover;
  }
  /* Cifras de impacto en columnas. */
  .prose :global(.stats) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0;
  }
  /* Mismo tamaño que el texto del contenido; la cifra en negrita. */
  .prose :global(.stats dt),
  .prose :global(.stats dd) {
    margin: 0;
  }
  .prose :global(.stats dt) {
    font-weight: 700;
  }
  @media (max-width: 40rem) {
    .prose :global(.stats) {
      grid-template-columns: 1fr;
    }
    /* En celular, las imágenes de la fila van una debajo de la otra, sin recortar. */
    .prose :global(.image-row),
    .prose :global(.image-row--2) {
      grid-template-columns: 1fr;
    }
    .prose :global(.image-row:not(.image-row--2) img) {
      aspect-ratio: auto;
    }
    /* Variante: las dos primeras imágenes quedan lado a lado y la tercera debajo, a todo el ancho
       (p. ej. los dos GIF de DiDi y luego la imagen fija). */
    .prose :global(.image-row--pair-mobile) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .prose :global(.image-row--pair-mobile > :nth-child(3)) {
      grid-column: 1 / -1;
    }
  }
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 3px solid var(--accent);
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
</style>

<script is:inline>
  // Video del hero: se elige con JavaScript (no con <source media>) porque en iPhone el navegador
  // a veces evalúa la pantalla antes de tiempo y cargaba la versión horizontal, que se veía con zoom.
  // Si la orientación "se corrige" después (o se gira el teléfono), se cambia a la versión correcta.
  (function () {
    var video = document.querySelector('[data-hero-video]');
    if (!video) return;
    var vertical = window.matchMedia('(max-aspect-ratio: 3/4)');
    // El hero está siempre en loop, también con "reducir movimiento" activado (decisión de diseño).
    function apply() {
      var mobile = vertical.matches && video.dataset.srcMobile;
      var src = mobile ? video.dataset.srcMobile : video.dataset.src;
      if (video.dataset.current === src) return;
      video.dataset.current = src;
      video.poster = (mobile && video.dataset.posterMobile) || video.dataset.poster || '';
      video.muted = true;
      video.src = src;
      video.play().catch(function () {});
    }
    // Si el video quedó pausado, se vuelve a reproducir. En iPhone pasa al volver a la página
    // con "atrás" (Safari la restaura con el video detenido) o con el modo de ahorro de batería,
    // que bloquea la reproducción automática hasta que la persona toca o desliza la pantalla.
    function resume() {
      if (!video.paused || document.hidden) return;
      video.muted = true;
      video.play().catch(function () {});
    }
    apply();
    if (vertical.addEventListener) vertical.addEventListener('change', apply);
    window.addEventListener('resize', apply);
    window.addEventListener('pageshow', function () { apply(); resume(); });
    document.addEventListener('visibilitychange', resume);
    ['touchstart', 'scroll', 'click'].forEach(function (type) {
      window.addEventListener(type, resume, { passive: true });
    });
  })();
</script>

<script is:inline>
  // Menú lateral: marca la sección visible y, al hacer clic, se desplaza con "easy ease".
  (function () {
    var nav = document.querySelector('[data-case-nav]');
    if (!nav) return;
    var list = nav.querySelector('ul');
    var links = Array.prototype.slice.call(nav.querySelectorAll('a'));
    var targets = links.map(function (a) { return document.getElementById(decodeURIComponent(a.hash.slice(1))); });
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = -1;
    var animating = false;

    function setActive(i) {
      if (i === current) return;
      current = i;
      links.forEach(function (a, j) { a.setAttribute('aria-current', j === i ? 'true' : 'false'); });
      if (i < 0) { list.style.setProperty('--bar-o', '0'); return; }
      // La barra mide solo lo que ocupa el texto (sin el espacio de arriba y abajo).
      var a = links[i];
      var cs = getComputedStyle(a);
      var padTop = parseFloat(cs.paddingTop);
      var padBottom = parseFloat(cs.paddingBottom);
      list.style.setProperty('--bar-y', a.offsetTop + padTop + 'px');
      list.style.setProperty('--bar-h', a.offsetHeight - padTop - padBottom + 'px');
      list.style.setProperty('--bar-o', '1');
    }

    function update() {
      if (animating) return;
      var line = window.innerHeight * 0.35;
      var active = -1;
      targets.forEach(function (t, i) { if (t && t.getBoundingClientRect().top <= line) active = i; });
      setActive(active);
    }

    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; update(); });
    }, { passive: true });
    window.addEventListener('resize', function () { current = -1; update(); });

    // Curva "easy ease" (cubic-bezier 0.33, 0, 0.67, 1).
    function easyEase(t) {
      var lo = 0, hi = 1, x;
      for (var k = 0; k < 20; k++) {
        x = (lo + hi) / 2;
        var bx = 3 * x * (1 - x) * (1 - x) * 0.33 + 3 * x * x * (1 - x) * 0.67 + x * x * x;
        if (bx < t) lo = x; else hi = x;
      }
      x = (lo + hi) / 2;
      return 3 * x * x * (1 - x) + x * x * x;
    }

    links.forEach(function (a, i) {
      a.addEventListener('click', function (e) {
        var t = targets[i];
        if (!t) return;
        e.preventDefault();
        var start = window.scrollY;
        var end = start + t.getBoundingClientRect().top - 32;
        history.replaceState(null, '', a.hash);
        setActive(i);
        if (reduceMotion) { window.scrollTo(0, end); return; }
        var distance = end - start;
        var duration = Math.min(1400, Math.max(700, Math.abs(distance) * 0.35));
        var html = document.documentElement;
        var prev = html.style.scrollBehavior;
        html.style.scrollBehavior = 'auto';
        animating = true;
        var t0 = null;
        function step(now) {
          if (t0 === null) t0 = now;
          var p = Math.min(1, (now - t0) / duration);
          window.scrollTo(0, start + distance * easyEase(p));
          if (p < 1) requestAnimationFrame(step);
          else { animating = false; html.style.scrollBehavior = prev; update(); }
        }
        requestAnimationFrame(step);
      });
    });

    update();
  })();
</script>

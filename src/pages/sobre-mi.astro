---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const skills = [
  { title: 'Investigación', items: ['Entrevistas', 'Tests de usabilidad', 'Análisis heurístico', 'Journey maps'] },
  { title: 'Diseño', items: ['Wireframes', 'Prototipado', 'Diseño de interfaces', 'Sistemas de diseño'] },
  { title: 'Herramientas', items: ['Figma', 'FigJam', 'Adobe Illustrator', 'Framer'] },
];
---

<BaseLayout title="Sobre mí">
  <section class="container intro">
    <p class="eyebrow">Sobre mí</p>
    <h1>Hola, soy {site.name}.</h1>
    <div class="text">
      <p>
        Soy {site.role.toLowerCase()} con experiencia en ilustración, diseño gráfico y diseño de
        producto digital. <!-- Escribe aquí tu historia: de dónde vienes, qué te motiva, cómo trabajas. -->
      </p>
      <p>
        Me interesa el punto donde la investigación se encuentra con lo visual: entender a las
        personas y traducir ese entendimiento en interfaces claras y con personalidad.
      </p>
    </div>
  </section>

  <section class="container skills">
    {
      skills.map(({ title, items }) => (
        <div>
          <h2>{title}</h2>
          <ul>
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(3rem, 10vw, 7rem) 3rem;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }
  .text {
    max-width: 60ch;
    font-size: 1.2rem;
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 2rem;
    border-top: 1px solid var(--line);
    padding-top: 3rem;
  }
  .skills h2 {
    font-size: 1.35rem;
  }
  .skills ul {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--muted);
  }
  .skills li + li {
    margin-top: 0.35rem;
  }
</style>

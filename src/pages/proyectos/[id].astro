---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
  );
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { title, summary, client, role, year, duration, tools, cover, accent } = project.data;
const { Content } = await render(project);

const facts = [
  { label: 'Cliente', value: client },
  { label: 'Rol', value: role },
  { label: 'Año', value: year },
  { label: 'Duración', value: duration },
  { label: 'Herramientas', value: tools.join(', ') },
].filter((f) => f.value);
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="container head">
      <a class="back" href="/#proyectos">← Proyectos</a>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="facts">
        {
          facts.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="container">
      <div class="cover" style={`background: ${accent}`}>
        {cover && <Image src={cover} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />}
      </div>
    </div>

    <div class="container prose">
      <Content />
    </div>

    {
      next && next.id !== project.id && (
        <nav class="container next" aria-label="Siguiente proyecto">
          <span class="eyebrow">Siguiente proyecto</span>
          <a href={`/proyectos/${next.id}/`}>{next.data.title} →</a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: 3rem;
  }
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    margin-top: 1.5rem;
  }
  .summary {
    font-size: 1.3rem;
    color: var(--muted);
    max-width: 50ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  dt {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  dd {
    margin: 0.25rem 0 0;
  }
  .cover {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prose {
    max-width: 46rem;
    padding-block: 4rem;
  }
  .prose :global(h2) {
    font-size: 2rem;
    margin-top: 2.5em;
  }
  .prose :global(h3) {
    font-size: 1.4rem;
    margin-top: 2em;
  }
  .prose :global(img) {
    border-radius: var(--radius);
    margin-block: 2rem;
  }
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 3px solid var(--accent);
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
  .next {
    border-top: 1px solid var(--line);
    padding-top: 3rem;
  }
  .next a {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    text-decoration: none;
    margin-top: 0.5rem;
  }
  .next a:hover {
    color: var(--accent);
  }
</style>
